# Writes OUT, a C header holding the file IN as a byte array NAME (scorescript.lua for scriptengine.cpp: a byte
# array, not a string literal, because MSVC limits a literal to 64 kB).
# cmake -DIN=<file> -DOUT=<header> -DNAME=<identifier> -P embed_lua.cmake
file(READ "${IN}" HEX_CONTENT HEX)
string(LENGTH "${HEX_CONTENT}" HEX_LENGTH)
math(EXPR BYTES "${HEX_LENGTH} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f])" "\\1\n" HEX_CONTENT "${HEX_CONTENT}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," HEX_CONTENT "${HEX_CONTENT}")
file(WRITE "${OUT}" "// generated by libmscore/script/embed_lua.cmake from ${NAME}'s source; don't edit\nstatic const unsigned char ${NAME}[] = {\n${HEX_CONTENT}\n0 };\nstatic const unsigned ${NAME}_len = ${BYTES};\n")
