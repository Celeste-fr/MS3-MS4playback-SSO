@echo off
rem Measure the dynamics of Spitfire Symphony Orchestra's patches, in the background.
rem
rem Double-click this file. It starts this MuseScore with no window (MuseScore --extract-library ...
rem --check-dynamics): every patch of the map, one after the other, offline, at below-normal priority.
rem It uses a copy of your setups (Documents\MuseScore Sound Library Check\background dynamics check
rem setups) and writes nothing in MuseScore's own folders until the end, when the measured curves go
rem into your calibration (soundlibraries\Spitfire Symphony Orchestra\dynamics.json; MuseScore uses
rem them at its next start). Only one runs at a time. It runs from this folder: install other builds
rem in other folders while it runs.
rem
rem Only some patches: put their names, one a line, in a text file and drag it onto this file.
rem Progress: Documents\MuseScore Sound Library Check\background dynamics check.log
rem When it is done, that folder opens; hand back the newest "Spitfire Symphony Orchestra <date>.zip".
rem To stop it: Task Manager, end @MSCORE_OUTPUT_NAME@.exe (the one without a window).

setlocal
set "PATCHES=mapped"
if not "%~1"=="" set "PATCHES=%~f1"

start "" "%~dp0@MSCORE_OUTPUT_NAME@.exe" --extract-library "Spitfire Symphony Orchestra" --check-dynamics --extract-patches "%PATCHES%"

echo The dynamics check runs in the background (patches: %PATCHES%).
echo Progress: %USERPROFILE%\Documents\MuseScore Sound Library Check\background dynamics check.log
echo That folder opens when it is done. You can close this window and keep working.
timeout /t 15
